#!/bin/sh
# Runs vp-frames with the app's own Electron, so Claude doesn't need Node installed.
here="$(dirname "$(readlink -f "$0")")"
electron="$here/../../../electron"                                 # installed: resources/app/bin
[ -x "$electron" ] || electron="$here/../node_modules/electron/dist/electron"  # from source
ELECTRON_RUN_AS_NODE=1 exec "$electron" "$here/../dist/frames/main.js" "$@"
